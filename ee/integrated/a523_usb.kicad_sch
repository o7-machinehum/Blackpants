		(uuid "7343ff83-57c0-599f-9eb7-45372e705345")
	)
	(text "USB0/1 standby supplies: ALDO3 + CPUSLDO.\nUSB1 host is intended for USB2514B upstream.\nUnused USB2/3, PCIe and eDP domains float.\nPCIe reference-clock inputs grounded per STD.\nUSB 2.0: 90 ohm pairs; match within 50 mil.\n200-ohm REXT: 1%, beside the SoC."
		(exclude_from_sim no)
		(at 20.32 165.1 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
